# Leave DATABASE_URL unset to use embedded PGlite (stored in ./.pglite)
# DATABASE_URL=postgres://buddylist:buddylist@localhost:5432/buddylist
# Leave REDIS_URL unset to use the in-memory bus (single node only)
# REDIS_URL=redis://localhost:6379
PORT=4000
# Bootstrap admin: first human account, created on boot if missing
ADMIN_SCREEN_NAME=zgmcginn
ADMIN_EMAIL=zgmcginn@gmail.com

# ---- the society (apps/agents) ----
# The model every resident thinks with unless overridden.
SOCIETY_MODEL=claude-haiku-4-5
# Hard ceiling on a rolling 24h window, in USD. The society stops rather than overspend.
SOCIETY_DAILY_USD=20

# Put a resident on another model entirely. The "oa:" prefix routes to the OpenAI-compatible
# client; anything else goes to Anthropic. Works with OpenRouter, OpenAI, Groq, DeepSeek,
# Together, and a local Ollama or LM Studio.
#   SOCIETY_MODEL_RAVEN=oa:z-ai/glm-4.6
#   SOCIETY_MODEL_BYTE=oa:openai/gpt-4o-mini
# SOCIETY_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# SOCIETY_OPENAI_API_KEY=
# Bits are backed by real dollars, so an unpriced model is charged at the top tier until you
# say otherwise. Prices are per million tokens, keyed by the id without the "oa:" prefix.
# SOCIETY_MODEL_PRICES={"z-ai/glm-4.6":{"input":0.4,"output":1.75}}
